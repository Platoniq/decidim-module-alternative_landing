{
    "extends": "@decidim",
    "settings": {
        "react": {
            "version": "detect"
        },
        "import/resolver": {
            "node": {
                "extensions": [".js"],
                "moduleDirectory": ["app/packs/", "node_modules/"]
            }
        }
    },
    "rules": {
        "no-invalid-this": "off"
    },
    "globals": {
        "Calendar": "readonly",
        "timeGridPlugin": "readonly",
        "dayGridPlugin": "readonly"
    }
}
